# ---------------------------------------------------------------- Database
# Supabase menyediakan beberapa connection string. Kita pakai dua:
#
#   DATABASE_URL  -> Transaction pooler (port 6543), dipakai aplikasi saat runtime.
#                    Tahan banyak koneksi pendek, cocok untuk serverless/Vercel.
#   DIRECT_URL    -> Session pooler (port 5432), dipakai migrasi & seed.
#                    Migrasi butuh koneksi penuh yang tidak boleh lewat
#                    transaction pooler.
#
# Ambil keduanya di: Supabase Dashboard -> Project Settings -> Database ->
# Connection string -> tab "ORMs" atau "Connection pooling".
# Ganti [PASSWORD] dengan password database, dan [REF]/[REGION] sesuai project.

DATABASE_URL="postgresql://postgres.[REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require"
DIRECT_URL="postgresql://postgres.[REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require"

# Alternatif untuk Postgres lokal (tanpa Supabase) — isi keduanya sama:
# DATABASE_URL="postgresql://USER@127.0.0.1:5432/kontem?schema=public"
# DIRECT_URL="postgresql://USER@127.0.0.1:5432/kontem?schema=public"

# ---------------------------------------------------------------- Auth
# Rahasia penandatangan session, minimal 32 karakter.
# Buat dengan: openssl rand -base64 32
AUTH_SECRET="ganti-dengan-string-acak-panjang"

# Google login (opsional, belum disambungkan di versi ini)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

NEXT_PUBLIC_APP_NAME="Kontem"
